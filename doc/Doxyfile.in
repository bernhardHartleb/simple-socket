# =============================================================================
# Project
# =============================================================================

PROJECT_NAME           = "@PROJECT_NAME@ library"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "@PROJECT_DESCRIPTION@"

OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/docs"

# Remove machine-specific path prefixes from generated documentation.
STRIP_FROM_PATH        = "@PROJECT_SOURCE_DIR@"
STRIP_FROM_INC_PATH    = "@PROJECT_SOURCE_DIR@/include"

# =============================================================================
# Input
# =============================================================================

INPUT                  = "@PROJECT_SOURCE_DIR@/include" \
                         "@PROJECT_SOURCE_DIR@/src" \
                         "@PROJECT_SOURCE_DIR@/doc/mainpage.dox" \
                         "@PROJECT_SOURCE_DIR@/doc/examples.dox"

FILE_PATTERNS          = *.h \
                         *.hh \
                         *.hpp \
                         *.hxx \
                         *.c \
                         *.cc \
                         *.cpp \
                         *.cxx \
                         *.md

RECURSIVE              = YES

EXCLUDE_PATTERNS       = */build/* \
                         */_build/* \
                         */_deps/* \
                         */third_party/* \
                         */vendor/*

EXAMPLE_PATH           = "@PROJECT_SOURCE_DIR@/examples"

#USE_MDFILE_AS_MAINPAGE = "@PROJECT_SOURCE_DIR@/README.md"

# =============================================================================
# Documentation extraction
# =============================================================================

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO

JAVADOC_AUTOBRIEF      = YES

BUILTIN_STL_SUPPORT    = YES

MARKDOWN_SUPPORT       = YES
MARKDOWN_STRICT        = YES
MARKDOWN_ID_STYLE      = GITHUB

# =============================================================================
# Source browsing
# =============================================================================

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
VERBATIM_HEADERS       = YES

# =============================================================================
# Warnings / CI
# =============================================================================

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES

# Generate everything, but make CI fail at the end if warnings occurred.
WARN_AS_ERROR          = FAIL_ON_WARNINGS

# =============================================================================
# Preprocessor
# =============================================================================

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO

# =============================================================================
# Documentation style
# =============================================================================

INLINE_INHERITED_MEMB  = YES
MULTILINE_CPP_IS_BRIEF = YES
DISTRIBUTE_GROUP_DOC   = YES

# =============================================================================
# HTML
# =============================================================================

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE        = TOGGLE

HTML_EXTRA_STYLESHEET  = "@PROJECT_SOURCE_DIR@/doc/socket.css"

SEARCHENGINE           = YES
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
PAGE_OUTLINE_PANEL     = YES

HTML_DYNAMIC_MENUS     = YES
HTML_DYNAMIC_SECTIONS  = YES
HTML_CODE_FOLDING      = YES
HTML_COPY_CLIPBOARD    = YES


# =============================================================================
# Other output formats
# =============================================================================

GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO

# =============================================================================
# Graphviz
# =============================================================================

HAVE_DOT               = YES
CLASS_GRAPH            = GRAPH
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
